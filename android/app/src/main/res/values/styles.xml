<resources>
    <style name="BaseAppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#626584</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FAF9F7</item>
        <item name="android:navigationBarColor">#FAF9F7</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#FAF9F7</item>
    </style>
    <style name="AppTheme" parent="BaseAppTheme" />
    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#B6B7DC</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#121318</item>
        <item name="android:navigationBarColor">#121318</item>
        <item name="android:windowBackground">#121318</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
