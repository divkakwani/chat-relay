        <package android:name="com.whatsapp.w4b" />
    </queries>
    <application android:label="Chat Relay" android:theme="@style/AppTheme" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="false" android:usesCleartextTraffic="false" android:supportsRtl="true">
